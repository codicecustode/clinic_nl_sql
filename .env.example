
# --- LLM Provider ---
# Choose one: gemini | groq | ollama
LLM_PROVIDER=gemini

# --- Option A: Google Gemini (default) ---
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Option B: Groq ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Option C: Ollama 
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3

# --- Database ---
DB_PATH=clinic.db

